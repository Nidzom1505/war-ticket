# ============================================
# TicketWar – Default Environment Variables
# ============================================

# ---------- PostgreSQL ----------
POSTGRES_USER=ticketwar
POSTGRES_PASSWORD=ticketwar_secret
POSTGRES_DB=ticketwar_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ticketwar:ticketwar_secret@db:5432/ticketwar_db

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ---------- JWT ----------
JWT_SECRET_KEY=super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ---------- Flask API ----------
FLASK_APP=app
FLASK_ENV=development
FLASK_DEBUG=1
API_PORT=8000

# ---------- Frontend ----------
VITE_API_BASE_URL=/api
